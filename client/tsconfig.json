{
  "extends": ["../tsconfig.json"],
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "jsx": "react-jsx",
    "types": ["vite/client", "react"],

    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
    },
  },

  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "src-tauri"]
}
