{
  "name": "amball",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "packages/**",
    "server"
  ],
  "scripts": {
    "dev:client": "bun run --cwd client/ dev",
    "dev:server": "bun run --cwd server/ dev",
    "lint": "bun --bun run oxlint",
    "lint:fix": "bun --bun run oxlint --fix",
    "format": "bun --bun run oxfmt --check",
    "format:fix": "bun --bun run oxfmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "concurrently": "^9.2.5",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
